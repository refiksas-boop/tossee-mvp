# Tossee MVP - Git Ignore

# SSH Keys (NEVER commit)
*.pem
*.key
*.ppk
id_rsa*

# Environment files
.env
.env.local
.env.*.local

# WordPress
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/backup*/
wp-content/upgrade/
wp-content/w3tc-config/

# Database
*.sql
*.sql.gz
*.sqlite

# Logs
*.log
error_log
debug.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node
node_modules/
package-lock.json
yarn.lock

# Temporary files
*.tmp
*.temp
*.cache
